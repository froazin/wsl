# Based on https://github.com/github/gitignore/blob/main/Python.gitignore

# Ignore dist
dist/

# Logs
logs
*.log

# Environments
.env
.env.*
*.env
*.env.*
!.env.example

# Claude Code
**/settings.local.json
.claude/worktrees

# Python virtual environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Not a package, so no tooling environment tracks a lockfile
uv.lock

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
# Anchored to the root, so folders such as features/src/<feature>/lib/ aren't ignored.
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py.cover
*.lcov
.pytest_cache/

# Translations
*.mo
*.pot
cython_debug/

# Ruff cache
.ruff_cache/

# Ansible
.ansible/
*.retry
tests/output/

# Collections installed from requirements.yml. froazin/wsl is a tracked link
# back to the repository root.
/collections/ansible_collections/*
!/collections/ansible_collections/froazin/
/collections/ansible_collections/froazin/*
!/collections/ansible_collections/froazin/wsl
