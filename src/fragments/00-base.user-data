#cloud-config

# Copy the built dist/<distro>.user-data to
# %USERPROFILE%\.cloud-init\<distro>.user-data, beside the meta-data written
# from the README's example, before installing the distro. It applies once,
# on first boot, and the OOBE waits for it.
#
# Each file in this directory is a fragment of the user-data, which any
# distro's manifest.json in src/distros/ can list. `invoke build` joins a
# distro's fragments, in name order, into one MIME multipart file with
# `cloud-init devel make-mime`, one part per fragment. cloud-init renders each
# part's Jinja on its own, so a fragment sets every variable it uses, then
# merges the parts in order. Every fragment's merge_how appends its lists to
# the earlier fragments' lists, so runcmd runs in the order of the file names.

merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

locale: en_GB.UTF-8

package_update: true
package_upgrade: true
