packages:
  - gh

write_files:
  # Ubuntu Pro pins ESM at 510, which would otherwise win over upstream gh.
  - path: /etc/apt/preferences.d/github-cli
    permissions: "0644"
    content: |
      Package: gh
      Pin: origin cli.github.com
      Pin-Priority: 600
{% if user %}

runcmd:
  # gh needs no login to install a public extension, and skips one that is
  # already installed.
{% for ext in gh_exts.valid %}
  - [runuser, -l, "{{ user }}", -c, "gh extension install {{ ext }}"]
{% endfor %}
{# ASCII first: tojson writes non-BMP characters as surrogate pairs, which YAML decodes to lone surrogates that fail all of runcmd. printf, not echo: dash's echo interprets backslashes. #}
{% for ext in gh_exts.invalid %}
  - [printf, "Skipped gh_extensions entry, not an [https://][host/]owner/repo: %s\n", {{ ext.encode('ascii', 'backslashreplace').decode('ascii') | tojson }}]
{% endfor %}
{% endif %}
