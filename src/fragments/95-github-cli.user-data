## template: jinja
#cloud-config

merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

{% set user = ds.meta_data.username or '' %}
{% set gh_extensions = ds.meta_data.gh_extensions or [] %}
{% if gh_extensions is string %}
{% set gh_extensions = gh_extensions.replace(',', ' ').split() %}
{% elif gh_extensions is mapping or gh_extensions is not sequence %}
{% set gh_extensions = [] %}
{% endif %}
{# Only [https://][host/]owner/repo, each part [A-Za-z0-9][A-Za-z0-9._-]*, reach the shell. #}
{% set gh_exts = namespace(valid=[], invalid=[]) %}
{% for ext in gh_extensions %}
{% set url = (ext | string).startswith('https://') %}
{% set parts = (ext | string).removeprefix('https://').split('/') %}
{% set check = namespace(ok=ext is string and parts | length in ((3,) if url else (2, 3))) %}
{% for part in parts %}
{% if not (part[:1].isalnum() and part.isascii() and part.replace('.', '').replace('_', '').replace('-', '').isalnum()) %}
{% set check.ok = false %}
{% endif %}
{% endfor %}
{% if check.ok %}
{% set gh_exts.valid = gh_exts.valid + [ext] %}
{% else %}
{% set gh_exts.invalid = gh_exts.invalid + [ext | string] %}
{% endif %}
{% endfor %}

