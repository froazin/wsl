#cloud-config

# Copy the built dist/Ubuntu-26.04.user-data to
# %USERPROFILE%\.cloud-init\Ubuntu-26.04.user-data, alongside a filled-in copy
# of dist/Ubuntu-26.04.meta-data, before installing the distro. It applies
# once, on first boot, and the OOBE waits for it.
#
# Each file in this directory is one part of the user-data. `invoke build`
# joins them, in name order, into one MIME multipart file with
# `cloud-init devel make-mime`. cloud-init renders each part's Jinja on its
# own, so a part sets every variable it uses, then merges the parts in order.
# Every part's merge_how appends its lists to the earlier parts' lists, so
# runcmd runs in the order of the file names.

merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

locale: en_GB.UTF-8

package_update: true
package_upgrade: true
