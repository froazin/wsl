## template: jinja
#cloud-config

merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

{# The username from the meta-data, or wsluser when it gives none. #}
{% set user = ds.meta_data.username or 'wsluser' %}

# qemu-kvm is a virtual package and must not be listed.
packages:
  - qemu-system-x86
  - qemu-utils
  - libvirt-daemon-system
  - libvirt-clients
  - virtinst
  - ovmf
  - swtpm
  - swtpm-tools
  - cpu-checker

# libvirt is a group the packages create, so the user joins it here rather
# than in `users`.
runcmd:
  - [virsh, --connect, "qemu:///system", net-autostart, default]
  - [usermod, -aG, libvirt, "{{ user }}"]
  # open-iscsi comes with libvirt's iSCSI storage driver when recommends are
  # on. iscsid's abstract socket clashes between WSL instances, and finalrd
  # sets up a shutdown pivot root a WSL instance doesn't need. Masked even
  # when absent, so a later install leaves them off.
  - [systemctl, mask, finalrd.service, iscsid.socket]
