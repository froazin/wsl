## template: jinja
#cloud-config

merge_how:
  - name: list
    settings: [append]
  - name: dict
    settings: [no_replace, recurse_list]

{# The username from the meta-data, or wsluser when it gives none. #}
{% set user = ds.meta_data.username or 'wsluser' %}
{% set git_name = ds.meta_data.git_name or '' %}
{% set git_email = ds.meta_data.git_email or '' %}
{% set git_signingkey = ds.meta_data.git_signingkey or '' %}
{% set git_ssh_program = ds.meta_data.git_ssh_program or '' %}
{% if git_signingkey is string %}
{% set git_signingkey = git_signingkey.strip() %}
{% endif %}
{# GitHub username from a noreply address, ID+user@ or user@. #}
{% set gh_local, _, gh_domain = (git_email | string).rpartition('@') %}
{% set gh_user = gh_local.split('+', 1)[-1] if gh_domain | lower == 'users.noreply.github.com' else '' %}
{% if not gh_user.replace('-', '').isalnum() %}
{% set gh_user = '' %}
{% endif %}
{# allowed_signers line for a key git reads as literal, "key::<type> <base64> [comment]" or "ssh-<type> ..."; anything else is a key file path to git and gets none. The principal is git_email, or * when it has characters outside [A-Za-z0-9.+_@-]. #}
{% set literal_key = git_signingkey is string and git_signingkey.startswith(('key::', 'ssh-')) %}
{% set key_type, key_data = ((git_signingkey | string).removeprefix('key::').split() + ['', ''])[:2] %}
{% set principal = git_email | string %}
{% if not (principal.isascii() and principal.replace('.', '').replace('+', '').replace('_', '').replace('-', '').replace('@', '').isalnum()) %}
{% set principal = '*' %}
{% endif %}
{% set allowed_signer = '' %}
{% if literal_key and key_type.startswith(('ssh-', 'ecdsa-', 'sk-')) and (key_type ~ key_data).isascii() and key_type.replace('-', '').replace('@', '').replace('.', '').isalnum() and key_data.replace('+', '').replace('/', '').replace('=', '').isalnum() %}
{% set allowed_signer = principal ~ ' namespaces="git" ' ~ key_type ~ ' ' ~ key_data %}
{% endif %}
{% macro gitval(value) %}"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}

write_files:
  # Deferred until the user exists. The git module adds core.excludesfile later.
  - path: /home/{{ user }}/.gitconfig
    owner: "{{ user }}:{{ user }}"
    permissions: "0644"
    defer: true
    content: |
{% if git_name or git_email or git_signingkey %}
      [user]
{% if git_name %}
      	name = {{ gitval(git_name) }}
{% endif %}
{% if git_email %}
      	email = {{ gitval(git_email) }}
{% endif %}
{% if git_signingkey %}
      	signingkey = {{ gitval(git_signingkey) }}
{% endif %}
{% endif %}
      [init]
      	defaultBranch = main
      [core]
      	autocrlf = false
      	editor = /usr/local/bin/code --wait
      [safe]
      	directory = /home/{{ user }}/workspaces/*
      [credential "https://github.com"]
      	helper =
      	helper = !/usr/bin/gh auth git-credential
      [credential "https://gist.github.com"]
      	helper =
      	helper = !/usr/bin/gh auth git-credential
{% if git_signingkey %}
      [gpg]
      	format = ssh
      [commit]
      	gpgsign = true
{% endif %}
{% if git_ssh_program or allowed_signer %}
      [gpg "ssh"]
{% if git_ssh_program %}
      	program = {{ gitval(git_ssh_program) }}
{% endif %}
{% if allowed_signer %}
      	allowedSignersFile = ~/.config/git/allowed_signers
{% endif %}
{% endif %}
{% if allowed_signer %}

  # Lets git verify commits signed with git_signingkey. Parent directories
  # cloud-init creates here are owned by the user too.
  - path: /home/{{ user }}/.config/git/allowed_signers
    owner: "{{ user }}:{{ user }}"
    permissions: "0644"
    defer: true
    content: |
      {{ allowed_signer }}
{% endif %}

runcmd:
  # Layout the zsh `ws` picker expects: ~/workspaces/<host>/<owner>/<repo>.
  - [runuser, -u, "{{ user }}", --, mkdir, -p, "/home/{{ user }}/workspaces"]
{% if gh_user %}
  - [runuser, -u, "{{ user }}", --, mkdir, -p, "/home/{{ user }}/workspaces/github.com/{{ gh_user }}"]
{% endif %}
