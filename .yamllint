---
extends: default

ignore:
  - ".local/**" # Ignore local workspace files
  - ".venv/**" # Ignore virtual environment directories
  - "*vault.yml" # Ignore Ansible vault files

rules:
  line-length:
    max: 120
  comments-indentation: false
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
